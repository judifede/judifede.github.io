---
import { RECOMENDACION_JORGE } from '../../data/recomendaciones'
import RecomendacionBloque from './RecomendacionBloque.astro'

interface Props {
  variant?: 'page' | 'modal'
}

const { variant = 'page' } = Astro.props

const titleId = variant === 'page' ? 'recomendacion-jorge-title' : 'recomendacion-jorge-modal-title'
---

{
  variant === 'page' ? (
    <section
      class="mt-12 mx-auto w-full rounded-2xl border border-yellow-200/20 bg-white/5 p-6 md:p-8 text-center"
      aria-labelledby={titleId}
    >
      <h2 id={titleId} class="mb-6 text-2xl font-semibold text-yellow-300">
        Recomendación
      </h2>
      <RecomendacionBloque recomendacion={RECOMENDACION_JORGE} variante="page" />
    </section>
  ) : (
    <RecomendacionBloque recomendacion={RECOMENDACION_JORGE} variante="modal" />
  )
}
