{
  "name": "judifede-porfolio",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev",
    "host": "astro dev --host",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"const{rmSync}=require('fs');rmSync('.astro',{recursive:true,force:true});rmSync('node_modules/.vite',{recursive:true,force:true});rmSync('node_modules/.cache',{recursive:true,force:true});console.log('cachés limpias: .astro, node_modules/.vite, node_modules/.cache')\"",
    "fresh": "npm run clean && npm run host"
  },
  "dependencies": {
    "@astrojs/check": "0.5.5",
    "@astrojs/tailwind": "6.0.2",
    "@fontsource-variable/onest": "5.0.2",
    "@lucide/astro": "1.46.0",
    "astro": "5.7.13",
    "tailwindcss": "3.4.1",
    "typescript": "5.3.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "prettier-plugin-astro": "0.14.1"
  }
}
