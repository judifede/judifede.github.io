---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import type { ImageMetadata } from 'astro'

import RecursoProyecto from '../components/proyectos/RecursoProyecto.astro'
import type { RecursoProyecto as RecursoMultimedia } from '../components/proyectos/recursos'

import { ETIQUETAS, type Etiqueta } from '../data/etiquetas'
import { SECCIONES_PROYECTOS_META } from '../data/categorias'

import BotonEnlace from '../components/shared/BotonEnlace.astro'
import GitHubIcon from '../components/shared/icons/GitHub.astro'
import EnlaceIcon from '../components/shared/icons/Enlace.astro'
import PerfilIcon from '../components/shared/icons/Perfil.astro'
import PruebaIcon from '../components/shared/icons/Prueba.astro'
import Maletin from '../components/shared/icons/Maletin.astro'
import FiltrosIcon from '../components/shared/icons/FiltrosIcon.astro'

// Cargar todos los assets de proyectos desde src/content/proyectos/<id>/.
// Convención: el archivo de imagen tiene el mismo nombre que el slug de la carpeta.
const imagenesPorCarpeta = import.meta.glob<{ default: ImageMetadata }>(
  '../content/proyectos/*/*.{webp,png,jpg}',
  { eager: true }
)
const videosPorCarpeta = import.meta.glob<string>('../content/proyectos/*/*.mp4', {
  eager: true,
  query: '?url',
  import: 'default',
})

type CategoriaProyecto = 'corporativos' | 'pruebas-tecnicas' | 'personales'

interface ProyectoCompleto {
  id: string
  titulo: string
  descripciones: readonly string[]
  enlace?: string
  repositorio?: string
  recurso: RecursoMultimedia
  etiquetas: readonly Etiqueta[]
  categoria: CategoriaProyecto
  order: number
}

const proyectosEntries = await getCollection('proyectos')

const proyectos: ProyectoCompleto[] = proyectosEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => {
    // Cuando los .md viven en subcarpetas con `index.md`, Astro devuelve
    // `entry.id` como `<carpeta>/<archivo>` (p. ej. "ecoinge-canarias/index").
    // Usamos el primer segmento para mantener la convención de nombres.
    const id = entry.id.split('/')[0]
    const carpeta = `../content/proyectos/${id}/`
    const data = entry.data

    let recurso: RecursoMultimedia
    if (data.resource.type === 'imagen') {
      const imagenKey = `${carpeta}${id}.webp`
      const img = imagenesPorCarpeta[imagenKey]
      if (!img) throw new Error(`No se encontró imagen ${imagenKey}`)
      recurso = {
        tipo: 'imagen',
        fuente: img.default,
        textoAlternativo: data.resource.alt,
        ajuste: data.resource.fit,
      }
    } else {
      const videoKey = `${carpeta}${id}.mp4`
      const cartelKey = `${carpeta}${id}.webp`
      const video = videosPorCarpeta[videoKey]
      const cartel = imagenesPorCarpeta[cartelKey]
      if (!video || !cartel) throw new Error(`No se encontró vídeo o cartel para ${id}`)
      recurso = {
        tipo: 'video',
        fuente: video,
        cartel: cartel.default,
        etiquetaAccesible: data.resource.accessibleLabel,
        ajuste: data.resource.fit,
        ancho: data.resource.width,
        alto: data.resource.height,
      }
    }

    return {
      id,
      titulo: data.title,
      descripciones: data.descriptions,
      enlace: data.link,
      repositorio: data.repository,
      recurso,
      etiquetas: data.tags.map((t) => ETIQUETAS[t]),
      categoria: data.category,
      order: data.order,
    }
  })

const proyectosPorCategoria: Record<CategoriaProyecto, ProyectoCompleto[]> = {
  corporativos: proyectos.filter((p) => p.categoria === 'corporativos'),
  'pruebas-tecnicas': proyectos.filter((p) => p.categoria === 'pruebas-tecnicas'),
  personales: proyectos.filter((p) => p.categoria === 'personales'),
}

const clasesBaseBoton =
  'inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-yellow-400/50 px-3 py-2 text-xs text-white duration-300 hover:bg-yellow-400/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-200 sm:w-auto md:text-base'
const clasesActivoBoton =
  'data-[active=true]:border-2 data-[active=true]:border-yellow-300/20 data-[active=true]:pb-[calc(0.5rem-2px)] data-[active=true]:bg-yellow-300 data-[active=true]:text-black'

// Clases específicas para los botones del rail vertical (sm en adelante).
const clasesBaseBotonRail =
  'flex w-full min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1 rounded-md bg-yellow-400/50 px-2 py-2 text-xs text-white duration-300 hover:bg-yellow-400/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-200 sm:w-auto'
const clasesActivoBotonRail =
  'data-[active=true]:border-2 data-[active=true]:border-yellow-300/20 data-[active=true]:bg-yellow-300 data-[active=true]:text-black'
---

<Layout>
  <div>
    <div id="rail-wrapper">
      <!-- Nav en flujo: grid 3+1 con etiquetas -->
      <nav
        id="navegacion-filtros-flujo"
        aria-label="Filtros de categorías de proyectos"
        class="md:hidden grid grid-cols-3 gap-2 mb-6 bg-black transition-opacity duration-300 ease-in-out"
        style="opacity: 1; padding-top: 7px; padding-bottom: 7px;"
      >
        <button data-active="true" data-filter="todos" aria-pressed="true" aria-label="Todos" title="Todos" class:list={[clasesBaseBotonRail, clasesActivoBotonRail, 'col-span-3']}>
          <FiltrosIcon class="size-4" aria-hidden="true" />
          <span>Todos</span>
        </button>
        <button data-active="false" data-filter="corporativos" aria-pressed="false" aria-label="Corporativos" title="Corporativos" class:list={[clasesBaseBotonRail, clasesActivoBotonRail]}>
          <Maletin class="size-4" aria-hidden="true" />
          <span>Corporativos</span>
        </button>
        <button data-active="false" data-filter="pruebas-tecnicas" aria-pressed="false" aria-label="Pruebas Técnicas" title="Pruebas Técnicas" class:list={[clasesBaseBotonRail, clasesActivoBotonRail]}>
          <PruebaIcon class="size-4" aria-hidden="true" />
          <span>Pruebas Técnicas</span>
        </button>
        <button data-active="false" data-filter="personales" aria-pressed="false" aria-label="Personales" title="Personales" class:list={[clasesBaseBotonRail, clasesActivoBotonRail]}>
          <PerfilIcon class="size-4" aria-hidden="true" />
          <span>Personales</span>
        </button>
      </nav>

      <!-- Nav pegado: fila horizontal con solo iconos -->
      <nav
        id="navegacion-filtros-pegado"
        aria-label="Filtros de categorías de proyectos"
        aria-hidden="true"
        style="position: fixed; top: 6rem; left: 50%; translate: -50% 0; z-index: 30; opacity: 0; pointer-events: none;"
      >
        <button data-active="true" data-filter="todos" aria-pressed="true" aria-label="Todos" title="Todos" class="flex min-h-11 min-w-11 items-center justify-center rounded-full bg-yellow-400/50 px-2 py-2 text-xs text-white duration-300 hover:bg-yellow-400/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-200 data-[active=true]:bg-yellow-300 data-[active=true]:text-black">
          <FiltrosIcon class="size-4" aria-hidden="true" />
        </button>
        <button data-active="false" data-filter="corporativos" aria-pressed="false" aria-label="Corporativos" title="Corporativos" class="flex min-h-11 min-w-11 items-center justify-center rounded-full bg-yellow-400/50 px-2 py-2 text-xs text-white duration-300 hover:bg-yellow-400/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-200 data-[active=true]:bg-yellow-300 data-[active=true]:text-black">
          <Maletin class="size-4" aria-hidden="true" />
        </button>
        <button data-active="false" data-filter="pruebas-tecnicas" aria-pressed="false" aria-label="Pruebas Técnicas" title="Pruebas Técnicas" class="flex min-h-11 min-w-11 items-center justify-center rounded-full bg-yellow-400/50 px-2 py-2 text-xs text-white duration-300 hover:bg-yellow-400/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-200 data-[active=true]:bg-yellow-300 data-[active=true]:text-black">
          <PruebaIcon class="size-4" aria-hidden="true" />
        </button>
        <button data-active="false" data-filter="personales" aria-pressed="false" aria-label="Personales" title="Personales" class="flex min-h-11 min-w-11 items-center justify-center rounded-full bg-yellow-400/50 px-2 py-2 text-xs text-white duration-300 hover:bg-yellow-400/80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-200 data-[active=true]:bg-yellow-300 data-[active=true]:text-black">
          <PerfilIcon class="size-4" aria-hidden="true" />
        </button>
      </nav>
    </div>

    <nav
      id="navegacion-filtros-md"
      aria-label="Filtros de categorías de proyectos"
      class="hidden md:flex md:flex-row md:flex-wrap md:items-center md:justify-between md:gap-x-3 md:sticky md:top-24 md:z-30 md:mb-10 md:rounded-full md:bg-gray-900/95 md:px-4 md:py-3 md:shadow-md md:shadow-black/40 md:backdrop-blur-sm md:border md:border-yellow-300/20"
    >
      <button
        type="button"
        class:list={[clasesBaseBoton, clasesActivoBoton]}
        data-active="true"
        data-filter="todos"
        aria-pressed="true"
      >
        <FiltrosIcon class="size-4" aria-hidden="true" />
        Todos
      </button>
        <button
          type="button"
          class:list={[clasesBaseBoton, clasesActivoBoton]}
          data-active="false"
          data-filter="corporativos"
          aria-pressed="false"
        >
          <Maletin class="size-4" aria-hidden="true" />
          Corporativos
        </button>
        <button
          type="button"
          class:list={[clasesBaseBoton, clasesActivoBoton]}
          data-active="false"
          data-filter="pruebas-tecnicas"
          aria-pressed="false"
        >
          <PruebaIcon class="size-4" aria-hidden="true" />
          Pruebas Técnicas
        </button>
        <button
          type="button"
          class:list={[clasesBaseBoton, clasesActivoBoton]}
          data-active="false"
          data-filter="personales"
          aria-pressed="false"
        >
          <PerfilIcon class="size-4" aria-hidden="true" />
          Personales
        </button>
    </nav>

    {
      SECCIONES_PROYECTOS_META.map(({ id, categoria, titulo, icono: IconoSeccion, claseIcono }) => (
        <section id={id} data-category={categoria}>
          <h1 class="mb-6 flex scroll-mt-32 items-center justify-center gap-x-3 text-3xl font-semibold text-yellow-300 md:scroll-mt-32 md:justify-start">
            <IconoSeccion class:list={['size-8', claseIcono]} />
            {titulo}
          </h1>

          {proyectosPorCategoria[categoria].map((proyecto) => (
            <article
              id={proyecto.id}
              class="project-article relative mb-20 flex flex-col space-y-8 before:mb-8 before:block before:h-[2px] before:w-full before:bg-yellow-100 before:content-['']"
            >
              <h2 class="text-center text-2xl font-bold text-gray-100">{proyecto.titulo}</h2>

              <RecursoProyecto recurso={proyecto.recurso} />

              <div class="flex flex-col flex-wrap">
                <div class="mt-3">
                  {proyecto.descripciones.map((descripcion) => (
                    <p class="my-2" set:html={descripcion} />
                  ))}
                </div>

                <ul class="my-2 flex flex-row flex-wrap justify-start gap-x-2">
                  {proyecto.etiquetas.map(
                    ({ nombre, titulo: tituloEtiqueta, clase, icono: IconoEtiqueta }) => (
                      <li class="mt-2">
                        <span class:list={['flex gap-x-2 rounded-full px-3 py-2 text-xs', clase]}>
                          <IconoEtiqueta
                            class:list={['size-4', tituloEtiqueta === 'Stripe' && 'w-12']}
                          />
                          {nombre}
                        </span>
                      </li>
                    )
                  )}
                </ul>

                <footer class="mt-4 flex flex-col sm:flex-row items-stretch sm:items-end justify-start gap-2 sm:gap-x-4">
                  {proyecto.repositorio && (
                    <BotonEnlace href={proyecto.repositorio}>
                      <GitHubIcon class="size-5" />
                      Código
                    </BotonEnlace>
                  )}
                  {proyecto.enlace && (
                    <BotonEnlace href={proyecto.enlace}>
                      <EnlaceIcon class="size-5" />
                      Ver proyecto
                    </BotonEnlace>
                  )}
                </footer>
              </div>
            </article>
          ))}
        </section>
      ))
    }

    <div id="anuncio-filtro" class="sr-only" role="status" aria-live="polite" aria-atomic="true">
    </div>
  </div>
</Layout>

<script>
  import '../utils/reproduccionVideosProyectos'
  import { MENSAJES_ANUNCIO_FILTRO } from '../data/filtros'

  // Estado y listeners del rail (sm y menores). Se limpian en astro:before-swap.
  let rafScroll: number | null = null
  let listenerScroll: (() => void) | null = null
  let navegacionFiltrosSm: HTMLElement | null = null
  let estaPegado = false

  const UMBRAL_STICKY_PX = 96 // 6rem

  function evaluarPegado() {
    rafScroll = null
    const flujo = document.getElementById('navegacion-filtros-flujo')
    const pegado = document.getElementById('navegacion-filtros-pegado')
    if (!flujo || !pegado) return

    const estaEnSm = window.matchMedia('(max-width: 767px)').matches
    const nuevoEstado = estaEnSm && flujo.getBoundingClientRect().top <= UMBRAL_STICKY_PX

    if (nuevoEstado === estaPegado) return
    estaPegado = nuevoEstado

    if (nuevoEstado) {
      flujo.style.opacity = '0'
      flujo.setAttribute('aria-hidden', 'true')
      flujo.style.pointerEvents = 'none'
      pegado.style.opacity = '1'
      pegado.setAttribute('aria-hidden', 'false')
      pegado.style.pointerEvents = 'auto'
    } else {
      flujo.style.opacity = '1'
      flujo.setAttribute('aria-hidden', 'false')
      flujo.style.pointerEvents = 'auto'
      pegado.style.opacity = '0'
      pegado.setAttribute('aria-hidden', 'true')
      pegado.style.pointerEvents = 'none'
    }
  }

  function onScroll() {
    if (rafScroll !== null) return
    rafScroll = requestAnimationFrame(evaluarPegado)
  }

  function limpiarEstadoSticky() {
    if (rafScroll !== null) {
      cancelAnimationFrame(rafScroll)
      rafScroll = null
    }
    if (listenerScroll) {
      window.removeEventListener('scroll', listenerScroll)
      listenerScroll = null
    }
    navegacionFiltrosSm = null
    estaPegado = false
  }

  function inicializarEstadoSticky() {
    if (listenerScroll) return // ya inicializado

    const nav = document.querySelector<HTMLElement>('#navegacion-filtros-flujo')
    if (!nav) return

    navegacionFiltrosSm = nav
    estaPegado = false

    listenerScroll = onScroll
    window.addEventListener('scroll', listenerScroll, { passive: true })
    // Estado inicial por si la página carga ya con scroll.
    onScroll()
  }

  function inicializarNavegacionFiltros() {
    const navegacionFiltros = document.querySelector<HTMLElement>('#navegacion-filtros-flujo')
    if (!navegacionFiltros) return

    inicializarEstadoSticky()
    if (navegacionFiltros.dataset.filtrosInicializados === 'true') return

    navegacionFiltros.dataset.filtrosInicializados = 'true'

    const esSeccionValida = (seccion: HTMLElement | null): seccion is HTMLElement =>
      seccion !== null
    const seccionesProyectos = [
      document.getElementById('seccion-corporativos'),
      document.getElementById('seccion-pruebas-tecnicas'),
      document.getElementById('seccion-personales'),
    ].filter(esSeccionValida)
    const anuncioFiltro = document.getElementById('anuncio-filtro')

    // Selecciona TODOS los botones con data-filter (rail + barra md+).
    const botonesFiltro: NodeListOf<HTMLButtonElement> =
      document.querySelectorAll('button[data-filter]')

    let filtroActual = 'todos'
    const botonActivoInicial = navegacionFiltros.querySelector<HTMLButtonElement>(
      'button[data-active="true"]'
    )
    if (botonActivoInicial) {
      filtroActual = botonActivoInicial.dataset.filter || 'todos'
    }

    function sincronizarBotones() {
      botonesFiltro.forEach((boton) => {
        const estaActivo = boton.dataset.filter === filtroActual
        boton.dataset.active = estaActivo.toString()
        boton.setAttribute('aria-pressed', estaActivo.toString())
      })
    }

    function aplicarFiltro() {
      const mostrarTodos = filtroActual === 'todos'

      seccionesProyectos.forEach((seccion) => {
        const categoriaSeccion = seccion.dataset.category
        seccion.classList.toggle('hidden', !mostrarTodos && filtroActual !== categoriaSeccion)
      })
    }

    function sincronizarAnuncio() {
      if (!anuncioFiltro) return
      const mensaje = MENSAJES_ANUNCIO_FILTRO[filtroActual] ?? MENSAJES_ANUNCIO_FILTRO.todos
      anuncioFiltro.textContent = mensaje
    }

    botonesFiltro.forEach((boton) => {
      boton.addEventListener('click', () => {
        const nuevoFiltro = boton.dataset.filter
        if (nuevoFiltro === filtroActual) return

        filtroActual = nuevoFiltro || 'todos'
        sincronizarBotones()
        aplicarFiltro()
        sincronizarAnuncio()
      })
    })

    sincronizarBotones()
    aplicarFiltro()
    sincronizarAnuncio()
  }

  document.addEventListener('DOMContentLoaded', inicializarNavegacionFiltros)
  document.addEventListener('astro:page-load', inicializarNavegacionFiltros)
  document.addEventListener('astro:before-swap', limpiarEstadoSticky)
</script>

<style is:global>
  #rail-wrapper {
    position: relative;
    width: 100%;
    z-index: 30;
  }

  #navegacion-filtros-pegado {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(10, 10, 10, 0.8);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(253, 224, 71, 0.3);
    border-radius: 9999px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
    width: fit-content;
    max-width: calc(100vw - 2rem);
    transition: opacity 300ms ease;
  }

  #navegacion-filtros-pegado > button {
    background: transparent;
    border: 0;
    border-radius: 9999px;
    box-shadow: none;
    padding: 0.25rem 0.5rem;
    color: #ffffff;
  }

  #navegacion-filtros-pegado > button[data-active="true"] {
    background: #facc15;
    color: #000000;
  }

  #navegacion-filtros-pegado > button[data-active="true"] svg {
    color: #000000;
  }

  @media (prefers-reduced-motion: reduce) {
    #navegacion-filtros-flujo,
    #navegacion-filtros-pegado {
      transition: none;
    }
  }
</style>
