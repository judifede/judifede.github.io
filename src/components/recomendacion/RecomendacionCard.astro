---
import RecomendacionBloque from './RecomendacionBloque.astro'

interface Props {
  nombre: string
  cargo: string
  empresa: string
  relacion?: string
  fecha: string
  fechaISO: string
  cita1: string
  cita2: string
  hrefLinkedIn: string
}

const {
  nombre,
  cargo,
  empresa,
  relacion = 'Supervisor directo',
  fecha,
  fechaISO,
  cita1,
  cita2,
  hrefLinkedIn,
} = Astro.props

const nombreSlug = nombre
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '')

const titleId = `recomendacion-card-a-${nombreSlug}`
---

<aside
  aria-labelledby={titleId}
  class="relative h-full w-full flex flex-col rounded-xl border border-white/15 border-t-4 border-t-yellow-300 bg-white/[0.04] shadow-sm shadow-black/20 pt-5 px-5 md:px-6 pb-5"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute right-4 top-3 text-7xl leading-none font-serif text-yellow-300/20 select-none"
  >
    “
  </span>

  <h2 id={titleId} class="sr-only">
    Recomendación profesional de {nombre}
  </h2>

  <div class="relative flex items-center gap-3">
    <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-yellow-300"></span>
    <p class="text-xs font-semibold uppercase tracking-widest text-yellow-300/90">Recomendación</p>
  </div>

  <RecomendacionBloque
    variante="card"
    recomendacion={{
      nombre,
      cargo,
      empresa,
      relacion,
      fecha,
      fechaISO,
      cita1,
      cita2,
      hrefLinkedIn,
    }}
  />
</aside>
