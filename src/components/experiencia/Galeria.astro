---
import 'swiper/css'
import 'swiper/css/navigation'
import 'photoswipe/style.css'

import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import CerrarIcon from '../shared/icons/Cerrar.astro'

interface Props {
  /** Folder bajo src/assets/gallery/ donde están las imágenes (sin / al inicio ni al final). */
  carpeta: string
  /** Prefijo de archivo dentro de la carpeta, p.ej. "educaajedrez.local_". */
  rutaGaleria: string | undefined
  /** id del elemento que abre/cierra la galería. */
  idBotonGaleria: string | undefined
  /** Cantidad de imágenes en la carpeta. */
  cantidad: number | undefined
}

const { carpeta, rutaGaleria, idBotonGaleria, cantidad } = Astro.props

// Cargamos las imágenes de la carpeta indicada. El prefijo permite filtrar las que correspondan.
const modulos = import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*/*.jpg', {
  eager: true,
})

const imagenes: ImageMetadata[] = []
if (rutaGaleria && cantidad) {
  for (let i = 1; i <= cantidad; i++) {
    const clave = `../assets/gallery/${carpeta}/${rutaGaleria}${i}.jpg`
    const modulo = modulos[clave]
    if (modulo) imagenes.push(modulo.default)
  }
}
---

<CerrarIcon
  id="cerrarGaleria"
  class="hidden cursor-pointer text-yellow-400 fixed right-4 sm:right-6 md:right-10 top-4 sm:top-5 w-7 z-40"
/>
<div
  id="fondoGaleria"
  class="hidden fixed top-0 left-0
  size-full bg-black/60 z-30
  transition-all duration-300"
>
</div>
<div
  class="max-w-[90%]
  hidden fixed md:top-20 top-16 left-[50%] -translate-x-[50%] z-40
  transition-all duration-300"
  id="contenedorGaleria"
>
  <div class="swiper">
    <div class="swiper-wrapper lg:!w-[1024px]">
      {
        imagenes.map((imagen, index) => (
          <div class="swiper-slide h-full min-h-72">
            <a
              class="inline-block md:h-[80vh] h-[70vh] w-full lg:w-[280px]"
              href={imagen.src}
              data-pswp-width="1200"
              data-pswp-height="2200"
              data-pswp-index={index}
            >
              <Image class="size-full" src={imagen} alt={`EducaAjedrez Imagen ${index + 1}`} />
            </a>
          </div>
        ))
      }
    </div>

    <div class="swiper-button-prev !text-yellow-400"></div>
    <div class="swiper-button-next !text-yellow-400"></div>
  </div>
</div>

<style is:global>
  @media (max-width: 1024px) {
    .pswp__zoom-wrap {
      width: 100% !important;
      margin: auto !important;
    }

    .pswp img {
      position: relative !important;
      margin: auto !important;
    }
  }
</style>

<script>
  import Swiper from 'swiper'
  import { Navigation } from 'swiper/modules'
  import PhotoSwipeLightbox from 'photoswipe/lightbox'

  new Swiper('.swiper', {
    modules: [Navigation],
    slidesPerView: 1,
    spaceBetween: 0,
    breakpoints: {
      1200: {
        slidesPerView: 3,
      },
      768: {
        slidesPerView: 2,
        spaceBetween: 15,
      },
    },
    navigation: {
      prevEl: '.swiper-button-prev',
      nextEl: '.swiper-button-next',
    },
  })

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#contenedorGaleria',
    children: 'a',
    pswpModule: () => import('photoswipe'),
  })
  lightbox.init()
</script>

<script define:vars={{ idBotonGaleria }}>
  document.addEventListener('DOMContentLoaded', () => {
    const botonGaleria = document.querySelector(`#${idBotonGaleria}`)
    const fondoGaleria = document.querySelector('#fondoGaleria')
    const cerrarGaleria = document.querySelector('#cerrarGaleria')
    const contenedorGaleria = document.querySelector('#contenedorGaleria')

    function ocultarGaleria() {
      contenedorGaleria.classList.toggle('hidden')
      fondoGaleria.classList.toggle('hidden')
      cerrarGaleria.classList.toggle('hidden')
    }
    if (botonGaleria) {
      botonGaleria.addEventListener('click', () => {
        ocultarGaleria()
      })
    }

    if (fondoGaleria) {
      fondoGaleria.addEventListener('click', () => {
        ocultarGaleria()
      })
    }

    if (cerrarGaleria) {
      cerrarGaleria.addEventListener('click', () => {
        ocultarGaleria()
      })
    }
  })
</script>
