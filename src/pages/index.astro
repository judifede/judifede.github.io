---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'

import ItemExperiencia from '../components/experiencia/ItemExperiencia.astro'
import Maletin from '../components/shared/icons/Maletin.astro'

const todasExperiencias = await getCollection('experiencia')
const experiencias = todasExperiencias
  .filter((e) => !e.data.extra)
  .sort((a, b) => a.data.order - b.data.order)
const experienciaAdicional = todasExperiencias
  .filter((e) => e.data.extra)
  .sort((a, b) => a.data.order - b.data.order)
---

<Layout>
  <section>
    <h1
      class="flex items-center justify-center mb-0 text-3xl font-semibold text-yellow-300 md:justify-start gap-x-3"
    >
      <Maletin class="size-8" />
      Experiencia laboral
    </h1>

    <div
      class="before:content-[''] before:block before:w-full before:h-[2px] before:bg-yellow-100 before:mb-8 before:mt-6"
    >
    </div>

    <ol class="relative mt-16">
      {
        experiencias.map((exp) => (
          <li class="[&:first-child>article]:border-t-0 [&:first-child>article]:pt-0">
            <ItemExperiencia {...exp.data} links={exp.data.links} />
          </li>
        ))
      }
    </ol>

    <h2
      class="mt-16 flex items-center justify-center md:justify-start mb-0 text-2xl font-semibold text-yellow-300 gap-x-3"
    >
      Experiencia adicional
    </h2>

    <div
      class="before:content-[''] before:block before:w-full before:h-[2px] before:bg-yellow-100 before:mb-8 before:mt-6"
    >
    </div>

    <ol class="relative mt-10">
      {
        experienciaAdicional.map((exp) => (
          <li class="[&:first-child>article]:border-t-0 [&:first-child>article]:pt-0">
            <ItemExperiencia {...exp.data} links={exp.data.links} />
          </li>
        ))
      }
    </ol>
  </section>
</Layout>
