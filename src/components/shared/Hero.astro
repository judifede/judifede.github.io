---
import Insignia from './Insignia.astro'
import EnlacesSociales from './EnlacesSociales.astro'

const disponibilidad_inmediata = true
---

<section>
  <div class="flex items-center gap-x-3 sm:gap-x-5 mb-4 flex-wrap">
    <img
      class="inline-block rounded-full size-16"
      src="/hero/CV_perfil.webp"
      alt="Foto del Currículum"
    />
    <a
      href="https://www.linkedin.com/in/diego-fdez-1b0009109/"
      target="_blank"
      rel="noopener"
      aria-label="Enlace a LinkedIn de Diego Fernández: disponibilidad inmediata"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Insignia
        >{
          disponibilidad_inmediata ? 'Disponibilidad inmediata' : 'Abierto a nuevas oportunidades'
        }</Insignia
      >
    </a>
  </div>

  <h1 class="text-white text-2xl md:text-32 font-bold pb-4">🖐️, soy Diego Fernández</h1>
  <div class="text-pretty">
    <h2 class="text-2xl md:text-3xl font-medium text-yellow-200/90 m-0">
      Desarrollador web full stack y automatización
    </h2>
    <p class="text-lg sm:text-2xl opacity-90 flex flex-wrap items-center gap-x-2">
      <span>Las Palmas de Gran Canaria</span>
      <img
        class="inline-block size-6"
        src="/hero/bandera_canarias.webp"
        alt=""
        aria-hidden="true"
      />
    </p>
  </div>

  <EnlacesSociales ariaLabel="Redes sociales de Diego Fernández" />
</section>
