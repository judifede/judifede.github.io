---
import '@fontsource-variable/onest'
import '../styles/global.css'
import Cabecera from '../components/shared/Header.astro'
import Footer from '../components/shared/Footer.astro'
import { ClientRouter } from 'astro:transitions'
// Nota: ViewTransitions (astro:transitions/view-transitions) usa la API
// nativa del navegador y reduce el CLS percibido. ClientRouter sigue
// siendo válido para esta build; si se observa CLS notable al cambiar de
// ruta, cambiar a ViewTransitions.
import Hero from '../components/shared/Hero.astro'
import PopupRecomendacion from '../components/recomendacion/PopupRecomendacion.astro'
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Porfolio de Diego Fernández, desarrollador web full stack especializado en automatización. Disponible en Las Palmas de Gran Canaria y modalidad flexible."
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <link rel="icon" type="image/webp" href="/logos/jd-knight-gold-deep.webp" />
    <title>Porfolio de Diego Fernández - Desarrollador y Programador Web</title>
  </head>
  <body class="relative overflow-x-clip text-white">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Cabecera />
    <main
      class="container w-full mx-auto py-32 flex flex-col gap-y-10 items-center justify-center px-4 lg:max-w-4xl md:max-w-2xl md:items-start pt-24 sm:pt-28"
    >
      <Hero />
      <slot />
    </main>
    <Footer />
    <PopupRecomendacion />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html {
    font-family: 'Onest Variable', system-ui, sans-serif;
  }

  body {
    color: white;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
</style>

<script>
  import '../utils/dialogs.ts'
</script>
