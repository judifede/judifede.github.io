---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'

import Perfil from '../components/shared/icons/Perfil.astro'
import Escuela from '../components/shared/icons/Escuela.astro'
import ItemFormacion from '../components/formacion/ItemFormacion.astro'
import RecomendacionJorge from '../components/recomendacion/RecomendacionJorge.astro'

const formaciones = (await getCollection('formacion')).sort((a, b) => a.data.order - b.data.order)
---

<Layout>
  <section>
    <article>
      <h1
        class="flex items-center justify-center md:justify-start mb-6 text-3xl font-semibold gap-x-3 text-yellow-300"
      >
        <Escuela class="size-8" />
        Formación
      </h1>

      <div
        class="before:content-[''] before:block before:w-full before:h-[2px] before:bg-yellow-100 before:mb-8 before:mt-6"
      >
      </div>

      <ol class="relative mt-16">
        {
          formaciones.map((formacion) => (
            <li class="[&:first-child>article]:border-t-0 [&:first-child>article]:pt-0">
              <ItemFormacion {...formacion.data} />
            </li>
          ))
        }
      </ol>
    </article>

    <RecomendacionJorge variant="page" />

    <article class="mt-16">
      <h1
        class="flex items-center justify-center md:justify-start mb-6 text-3xl font-semibold gap-x-3 text-yellow-300"
      >
        <Perfil class="size-8" />
        Sobre mí
      </h1>

      <div
        class="before:content-[''] before:block before:w-full before:h-[2px] before:bg-yellow-100 before:mb-8 before:mt-6"
      >
      </div>

      <div class="mt-16 flex justify-between items-center gap-4 text-pretty flex-col md:flex-row">
        <p class="[&>*>strong]:text-yellow-100 [&>*>strong]:font-medium order-2 md:order-1">
          <span
            >Me llamo Diego Fernández, un placer tratar contigo.
            <br />Empecé en el mundo de la programación en 4º ESO con HTML y CSS, sin saber que a
            día de hoy me iba a seguir gustando tanto, tenía 15 años. Actualmente he podido <strong
              >trabajar en diferentes roles dentro de la informática</strong
            >.</span
          >
          <br />
          <br />
          <span>
            Me considero una <strong>persona empática, proactiva y analítica</strong>. Estas
            cualidades se reflejan tanto en mi trabajo como en mis actividades. Ya sea, desde los 10
            años, a través del <strong>ajedrez</strong> como una de mis grandes pasiones, como al descubrir
            diferentes deportes, juegos y competiciones. Esta variedad de intereses me ha dado una perspectiva
            amplia y un enfoque adaptable en mi <strong>carrera como programador</strong>.</span
          >
        </p>

        <div class="min-w-0 w-full max-w-sm md:min-w-72 md:w-96 order-1 md:order-2 p-1 lg:p-2">
          <picture>
            <source media="(max-width:767px)" srcset="/about/about_mv.png" />
            <img class="block h-auto w-full" src="/about/about.png" alt="About" />
          </picture>
        </div>
      </div>
    </article>
  </section>
</Layout>
