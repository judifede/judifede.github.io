---
import './galeria.css'

/**
 * Galería unificada de imágenes.
 *
 * No usa librerías externas (sin Swiper, sin PhotoSwipe).
 *
 * Comportamiento:
 *  - Modal fullscreen basado en `<dialog>` nativo.
 *  - Header con contador y botón cerrar.
 *  - Imagen centrada con `object-contain` (o `object-cover` si `fit === 'recortar'`).
 *  - Footer con tira horizontal de miniaturas `snap-x snap-mandatory`.
 *  - Prev/next flotantes (ocultos si solo hay 1 imagen).
 *  - Teclado: ←/→ navega, Esc cierra (el `<dialog>` ya gestiona Esc).
 *  - Gestos: swipe horizontal con Pointer Events (umbral ~50px).
 *  - Al cerrar, devuelve el foco al botón "Ver galería".
 *  - Body scroll lock automático vía `dialog.showModal()`.
 *  - Respeta `prefers-reduced-motion`.
 *  - Soporta múltiples instancias en la misma página (cada `idInstancia` único).
 *  - Se re-vincula en cada navegación de Astro View Transitions.
 */
export type GaleriaFit = 'encajar' | 'recortar'

export interface GaleriaItem {
  src: string
  width: number
  height: number
  alt: string
  fit: GaleriaFit
}

interface Props {
  idInstancia: string
  imagenes: GaleriaItem[]
  textoBoton?: string
  clasesBoton?: string
}

const { idInstancia, imagenes, textoBoton = 'Ver galería', clasesBoton } = Astro.props as Props

const idBoton = `galeria-abrir-${idInstancia}`
const idModal = `galeria-modal-${idInstancia}`
const idContador = `galeria-contador-${idInstancia}`
const idImagen = `galeria-imagen-${idInstancia}`
const idTira = `galeria-tira-${idInstancia}`
const idPrev = `galeria-prev-${idInstancia}`
const idNext = `galeria-next-${idInstancia}`
const idCerrar = `galeria-cerrar-${idInstancia}`

// Serializamos los items a JSON para inyectarlos como atributo data-.
// El JS del controlador espera `{src, width, height, alt, fit}`.
const imagenesJson = JSON.stringify(
  imagenes.map((it) => ({
    src: it.src,
    width: it.width,
    height: it.height,
    alt: it.alt,
    fit: it.fit,
  }))
)

const variasImagenes = imagenes.length > 1

const primeraImagen = imagenes[0]
const primeraImagenRatio = primeraImagen
  ? `${primeraImagen.width} / ${primeraImagen.height}`
  : '16 / 9'
---

<button
  id={idBoton}
  type="button"
  data-galeria-abrir={idInstancia}
  data-galeria-modal={idModal}
  aria-haspopup="dialog"
  aria-controls={idModal}
  aria-expanded="false"
  class:list={['btn-link-pill', clasesBoton]}
>
  <slot name="icono" />
  {textoBoton}
</button>

<dialog
  id={idModal}
  data-galeria-modal={idInstancia}
  data-galeria-items={imagenesJson}
  class="galeria-dialog"
  aria-label="Galería de imágenes"
>
  <div class="galeria-toolbar">
    <span id={idContador} class="galeria-contador" aria-live="polite" aria-atomic="true">
      1 / {imagenes.length}
    </span>
    <button
      id={idCerrar}
      type="button"
      class="galeria-cerrar"
      data-galeria-cerrar
      aria-label="Cerrar galería"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M20.7457 3.32851C20.3552 2.93798 19.722 2.93798 19.3315 3.32851L12.0371 10.6229L4.74275 3.32851C4.35223 2.93798 3.71906 2.93798 3.32854 3.32851C2.93801 3.71903 2.93801 4.3522 3.32854 4.74272L10.6229 12.0371L3.32856 19.3314C2.93803 19.722 2.93803 20.3551 3.32856 20.7457C3.71908 21.1362 4.35225 21.1362 4.74277 20.7457L12.0371 13.4513L19.3315 20.7457C19.722 21.1362 20.3552 21.1362 20.7457 20.7457C21.1362 20.3551 21.1362 19.722 20.7457 19.3315L13.4513 12.0371L20.7457 4.74272C21.1362 4.3522 21.1362 3.71903 20.7457 3.32851Z"
        ></path>
      </svg>
    </button>
  </div>

  <div class="galeria-main" data-galeria-main>
    <img
      id={idImagen}
      class="galeria-imagen"
      src={imagenes[0]?.src}
      alt={imagenes[0]?.alt ?? ''}
      decoding="async"
      style={`--galeria-ratio: ${primeraImagenRatio};`}
      data-galeria-imagen
      tabindex="0"
      role="button"
      aria-label="Imagen ampliable. Click para acercar, doble click para alternar."
    />

    {
      variasImagenes && (
        <>
          <button
            id={idPrev}
            type="button"
            class="galeria-nav galeria-nav-prev"
            data-galeria-prev
            aria-label="Imagen anterior"
          >
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M2 9.5L8.46875 2.9375C8.75 2.65625 9.1875 2.65625 9.46875 2.9375C9.75 3.21875 9.75 3.65625 9.46875 3.9375L4.21875 9.28125H17.5C17.875 9.28125 18.1875 9.59375 18.1875 9.96875C18.1875 10.3438 17.875 10.6875 17.5 10.6875H4.15625L9.46875 16.0938C9.75 16.375 9.75 16.8125 9.46875 17.0938C9.34375 17.2188 9.15625 17.2812 8.96875 17.2812C8.78125 17.2812 8.59375 17.2188 8.46875 17.0625L2 10.5C1.71875 10.2187 1.71875 9.78125 2 9.5Z"
                fill="currentColor"
              />
            </svg>
          </button>
          <button
            id={idNext}
            type="button"
            class="galeria-nav galeria-nav-next"
            data-galeria-next
            aria-label="Imagen siguiente"
          >
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M18 9.5L11.5312 2.9375C11.25 2.65625 10.8125 2.65625 10.5312 2.9375C10.25 3.21875 10.25 3.65625 10.5312 3.9375L15.7812 9.28125H2.5C2.125 9.28125 1.8125 9.59375 1.8125 9.96875C1.8125 10.3438 2.125 10.6875 2.5 10.6875H15.8437L10.5312 16.0938C10.25 16.375 10.25 16.8125 10.5312 17.0938C10.6562 17.2188 10.8437 17.2812 11.0312 17.2812C11.2187 17.2812 11.4062 17.2188 11.5312 17.0625L18 10.5C18.2812 10.2187 18.2812 9.78125 18 9.5Z"
                fill="currentColor"
              />
            </svg>
          </button>
        </>
      )
    }
  </div>

  {
    variasImagenes && (
      <div id={idTira} class="galeria-tira" role="tablist" aria-label="Miniaturas de la galería">
        {imagenes.map((item, idx) => (
          <button
            type="button"
            role="tab"
            class="galeria-miniatura"
            data-galeria-indice={idx}
            data-galeria-src={item.src}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={idImagen}
            aria-label={`Ir a la imagen ${idx + 1} de ${imagenes.length}: ${item.alt}`}
          >
            <img
              src={item.src}
              alt=""
              width={item.width}
              height={item.height}
              loading="lazy"
              decoding="async"
            />
          </button>
        ))}
      </div>
    )
  }
</dialog>

<script>
  import './galeria.ts'
</script>

<style>
  .btn-link-pill.compact-link {
    padding: 0.5rem 1rem;
    min-height: 2.75rem;
    flex: none;
    align-items: center;
    justify-content: center;
    align-self: center;
    font-weight: 400;
    margin-top: 0;
    margin-bottom: 0;
  }
</style>
