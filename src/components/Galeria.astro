---
import 'swiper/css'
import 'swiper/css/navigation'
import 'photoswipe/style.css'

import CerrarIcon from './icons/Cerrar.astro'

interface Props {
  rutaGaleria: string | undefined;
  idBotonGaleria: string | undefined;
  cantidad: number | undefined;
}

const { rutaGaleria, idBotonGaleria, cantidad } = Astro.props

const images = Array(cantidad).fill('/gallery/' + rutaGaleria);
---

<CerrarIcon
	id="cerrarGaleria"
	class="hidden cursor-pointer text-yellow-400 fixed right-10 top-5 w-7 z-40"
/>
<div
	id="fondoGaleria"
	class="hidden fixed top-0 left-0
  size-full bg-black/60 z-30
  transition-all duration-300"
>
</div>
<div
	class="max-w-[90%]
  hidden fixed md:top-20 top-16 left-[50%] -translate-x-[50%] z-40
  transition-all duration-300"
	id="contenedorGaleria"
>
	<div class="swiper">
		<div class="swiper-wrapper lg:!w-[1024px]">
			{
				images.map((image, index) => (
					<div class="swiper-slide h-full min-h-96">
						<a
							class="inline-block md:h-[80vh] h-[90vh] w-full lg:w-[280px] lg:translate-x-14"
							href={image + (index + 1) + '.jpg'}
							data-pswp-width="1200"
							data-pswp-height="2200"
							data-pswp-index={index}
						>
							<img
								class="size-full"
								src={image + (index + 1) + '.jpg'}
								alt={`EducaAjedrez Imagen ${index + 1}`}
							/>
						</a>
					</div>
				))
			}
		</div>

		<div class="swiper-button-prev !text-yellow-400"></div>
		<div class="swiper-button-next !text-yellow-400"></div>
	</div>
</div>

<style is:global>
  @media (max-width: 1024px) {
    .pswp__zoom-wrap {
      width: 100% !important;
      margin: auto !important;
    }

    .pswp img {
      position: relative !important;
      margin: auto !important;
    }
  }
</style>

<script>
import Swiper from 'swiper'
import { Navigation } from 'swiper/modules'
import PhotoSwipeLightbox from 'photoswipe/lightbox'

new Swiper('.swiper', {
  	modules: [Navigation],
  	slidesPerView: 1,
  	spaceBetween: 0,
  	breakpoints: {
  		1200: {
  			slidesPerView: 3,
  		},
  		768: {
  			slidesPerView: 2,
  			spaceBetween: 15,
  		},
  	},
  	navigation: {
  		prevEl: '.swiper-button-prev',
  		nextEl: '.swiper-button-next',
  	},
})

const lightbox = new PhotoSwipeLightbox({
  	gallery: '#contenedorGaleria',
  	children: 'a',
  	pswpModule: () => import('photoswipe'),
})
lightbox.init()
</script>

<script define:vars={{ idBotonGaleria }}>
 document.addEventListener('DOMContentLoaded', () => {
  	const botonGaleria = document.querySelector(`#${idBotonGaleria}`)
 	const fondoGaleria = document.querySelector('#fondoGaleria')
	const cerrarGaleria = document.querySelector('#cerrarGaleria')
	const contenedorGaleria = document.querySelector('#contenedorGaleria')

	function ocultarGaleria() {
  		contenedorGaleria.classList.toggle('hidden')
			fondoGaleria.classList.toggle('hidden')
			cerrarGaleria.classList.toggle('hidden')
	}
  	if (botonGaleria) {
  		botonGaleria.addEventListener('click', () => {
  			ocultarGaleria()
  		})
	}

  	if (fondoGaleria) {
  		fondoGaleria.addEventListener('click', () => {
  			ocultarGaleria()
  		})
	}

  	if (cerrarGaleria) {
  		cerrarGaleria.addEventListener('click', () => {
  			ocultarGaleria()
  		})
	}
 })
</script>
