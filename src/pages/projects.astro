const clasesBaseBoton = "bg-yellow-400/50 text-white cursor-pointer rounded-full py-2 px-3 duration-300 hover:bg-yellow-400/80 text-xs md:text-base"
const clasesActivoBoton = "data-[active=true]:bg-yellow-300 data-[active=true]:text-black"
---

<Layout>
  <div>
    <nav class="flex justify-between items-center py-4 mb-8" aria-label="Navegación entre secciones del sitio web">
      <FlechaIzquierda className="size-8" link="/" />
      <FlechaDerecha className="size-8" link="/about" />
    </nav>

    <nav id="navegacion-filtros" class="flex items-center py-4 mb-8 flex-wrap justify-around gap-x-2 sm:gap-x-3" aria-label="Filtros de categorías de proyectos">
        <button type="button" class:list={[clasesBaseBoton, clasesActivoBoton]} data-active="true" data-filter="all">Proyectos</button>
        <button type="button" class:list={[clasesBaseBoton, clasesActivoBoton]} data-active="false" data-filter="corporativos">Corporativos</button>
        <button type="button" class:list={[clasesBaseBoton, clasesActivoBoton]} data-active="false" data-filter="pruebas-tecnicas">Pruebas Técnicas</button>
        <button type="button" class:list={[clasesBaseBoton, clasesActivoBoton]} data-active="false" data-filter="personales">Personales</button>
    </nav>

    <section id="seccion-corporativos" data-category="corporativos">
      <h1
        class="flex items-center justify-center md:justify-start mb-6 text-3xl font-semibold gap-x-3 text-yellow-300"
      >
        <Maletin class="size-8" />
        Proyectos Corporativos
      </h1>
      {
        PROYECTOS_CORPORATIVOS.map(
          ({ projectid, title, descriptions, link, image, imageDesign, video, tags, }) => (
            <article
              id={projectid}
              class="project-article flex flex-col space-x-0 space-y-8 mb-20 relative before:content-[''] before:block before:w-full before:h-[2px] before:bg-yellow-100 before:mb-8"
            >
              <h2 class="text-2xl text-center font-bold text-gray-100">{title}</h2>
              <div class="w-full">
                <div class={`size-full overflow-hidden transition duration-500 rounded-xl md:group-hover:-translate-y-1 md:hover:shadow-2xl `}>
                  {image && <img src={image} class={`size-full max-h-[420px] object-${imageDesign} object-center transition duration-500 md:hover:scale-110`} loading="lazy" alt={`Imagen del proyecto ${title}`} />}
                  {video && <video class="size-full max-h-[420px] scale-125" autoplay loop muted="muted" controlslist="nodownload" src={video} />}
                </div>
              </div>
              <div class="w-full">
                <div class="flex flex-col flex-wrap mt-2 h-4/5">
                  <span class="mt-3">
                    {descriptions && descriptions.map((description) => <p class="my-2" set:html={description} />)}
                  </span>
                  <ul class="flex flex-wrap flex-row my-2 gap-x-2 justify-end">
                    {tags.map((tag) => (
                      <li class="mt-2">
                        <span class={`flex gap-x-2 rounded-full text-xs ${tag.clase} py-2 px-3 `}>
                          <tag.icono class={`size-4 ${tag.titulo === 'Stripe' && 'w-12'}`} />
                          {tag.nombre}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <footer class="flex items-end justify-start mt-4 gap-x-4">
                    {link && <BotonEnlace href={link}><EnlaceIcon class="size-5" />Ver proyecto</BotonEnlace>}
                  </footer>
                </div>
              </div>
            </article>
          )
        )
      }
    </section>

    <section id="seccion-pruebas-tecnicas" data-category="pruebas-tecnicas">
      <h1 class="flex items-center justify-center md:justify-start mb-6 text-3xl font-semibold gap-x-3 text-yellow-300">
        <PruebaIcon class="size-8 fill-yellow-300" />
        Pruebas Técnicas
      </h1>
      {
        PRUEBAS_TECNICAS.map(
          ({ projectid, title, descriptions, link, repositorioRemoto, image, imageDesign, tags, }) => (
            <article
              id={projectid}
              class="project-article flex flex-col space-x-0 space-y-8 mb-20 relative before:content-[''] before:block before:w-full before:h-[2px] before:bg-yellow-100 before:mb-8"
            >
              <h2 class="text-2xl text-center font-bold text-gray-100">{title}</h2>
              <div class="w-full">
                 <div class={`size-full overflow-hidden transition duration-500 rounded-xl md:group-hover:-translate-y-1 md:hover:shadow-2xl `}>
                   {image && <img src={image} class={`size-full max-h-[420px] object-${imageDesign} object-center transition duration-500 md:hover:scale-110`} loading="lazy" alt={`Imagen del proyecto ${title}`} />}
                 </div>
              </div>
              <div class="w-full">
                <div class="flex flex-col flex-wrap mt-2 h-4/5">
                  <span class="mt-3">
                    {descriptions && descriptions.map((description) => <p class="my-2" set:html={description} />)}
                  </span>
                  <ul class="flex flex-wrap flex-row my-2 gap-x-2 justify-end">
                    {tags.map((tag) => (
                      <li class="mt-2">
                        <span class={`flex gap-x-2 rounded-full text-xs ${tag.clase} py-2 px-3 `}>
                          <tag.icono class={`size-4 ${tag.titulo === 'Stripe' && 'w-12'}`} />
                          {tag.nombre}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <footer class="flex items-end justify-start mt-4 gap-x-4">
                    {repositorioRemoto && <BotonEnlace href={repositorioRemoto}><GitHubIcon class="size-5" />Code</BotonEnlace>}
                    {link && <BotonEnlace href={link}><EnlaceIcon class="size-5" />Ver proyecto</BotonEnlace>}
                  </footer>
                </div>
              </div>
            </article>
          )
        )
      }
    </section>

    <section id="seccion-personales" data-category="personales">
      <h1 class="flex items-center justify-center md:justify-start mb-6 text-3xl font-semibold gap-x-3 text-yellow-300">
        <PerfilIcon class="size-8" />
        Proyectos Personales
      </h1>
      {
        PROYECTOS_PERSONALES.map(
          ({ projectid, title, descriptions, link, repositorioRemoto, image, imageDesign, tags, }) => (
            <article
              id={projectid}
              class="project-article flex flex-col space-x-0 space-y-8 mb-20 relative before:content-[''] before:block before:w-full before:h-[2px] before:bg-yellow-100 before:mb-8"
            >
              <h2 class="text-2xl text-center font-bold text-gray-100">{title}</h2>
               <div class="w-full">
                 <div class={`size-full overflow-hidden transition duration-500 rounded-xl ${image && 'md:group-hover:-translate-y-1 md:hover:shadow-2xl '}`}>
                   {image && <img src={image} class={`size-full max-h-[420px] object-${imageDesign} object-center transition duration-500 md:hover:scale-110`} loading="lazy" alt={`Imagen del proyecto ${title}`} />}
                 </div>
              </div>
              <div class="w-full">
                 <div class="flex flex-col flex-wrap mt-2 h-4/5">
                    <span class="mt-3">
                      {descriptions && descriptions.map((description) => <p class="my-2" set:html={description} />)}
                    </span>
                    <ul class="flex flex-wrap flex-row my-2 gap-x-2 justify-end">
                      {tags.map((tag) => (
                        <li class="mt-2">
                          <span class={`flex gap-x-2 rounded-full text-xs ${tag.clase} py-2 px-3 `}>
                            <tag.icono class={`size-4 ${tag.titulo === 'Stripe' && 'w-12'}`} />
                            {tag.nombre}
                          </span>
                        </li>
                      ))}
                    </ul>
                    <footer class="flex items-end justify-start mt-4 gap-x-4">
                      {repositorioRemoto && <BotonEnlace href={repositorioRemoto}><GitHubIcon class="size-5" />Code</BotonEnlace>}
                      {link && <BotonEnlace href={link}><EnlaceIcon class="size-5" />Ver proyecto</BotonEnlace>}
                    </footer>
                 </div>
              </div>
            </article>
          )
        )
      }
    </section>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('#navegacion-filtros button[data-filter]')
    const seccionesProyectos = [
      document.getElementById('seccion-corporativos'),
      document.getElementById('seccion-pruebas-tecnicas'),
      document.getElementById('seccion-personales')
    ].filter(section => section !== null)

    let filtroActual = 'all'
    const botonActivoInicial = document.querySelector('#navegacion-filtros button[data-active="true"]')
    if (botonActivoInicial) {
      filtroActual = (botonActivoInicial as HTMLButtonElement).dataset.filter || 'all'
    }

    function aplicarFiltro() {
      const mostrarTodos = filtroActual === 'all'

      seccionesProyectos.forEach(section => {
        const categoriaSeccion = section.dataset.category
        if (mostrarTodos || filtroActual === categoriaSeccion) {
          section.classList.remove('hidden')
        } else {
          section.classList.add('hidden')
        }
      })
    }

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const nuevoFiltro = (button as HTMLButtonElement).dataset.filter
        if (nuevoFiltro === filtroActual) return

        filtroActual = nuevoFiltro || 'all'

        filterButtons.forEach(btn => {
          (btn as HTMLButtonElement).dataset.active = ((btn as HTMLButtonElement).dataset.filter === filtroActual).toString()
        })

        aplicarFiltro()
      })
    })

    aplicarFiltro()
  })
</script>
